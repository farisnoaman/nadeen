# Core application
# ── Coolify deployment notes ──────────────────────────────────────────────
# 1. DATABASE_URL: point it at a Coolify Postgres service, e.g.
#    postgresql://USER:PASSWORD@postgres-service-name:5432/fleetflow
#    If left empty the app falls back to an embedded database written to
#    ./data — then you MUST mount a persistent volume at /app/data or all
#    data is lost on every redeploy.
# 2. APP_URL and NEXT_PUBLIC_SITE_URL must both be your real public domain.
#    NEXT_PUBLIC_SITE_URL drives canonical URLs, hreflang, sitemap, and the
#    Open Graph tags. Set it in Coolify as a build-time variable too.
# ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
JWT_SECRET=replace-with-a-long-random-secret
APP_URL=https://your-real-domain.com
NEXT_PUBLIC_SITE_URL=https://your-real-domain.com

# Platform administrator bootstrap (change both values before production use)
PLATFORM_ADMIN_EMAIL=admin@fleetflow.com
PLATFORM_ADMIN_PASSWORD=

# Al Kuraimi Bank automatic subscription payments
# API URL, merchant ID, and create-payment path are managed in the platform admin UI.
KURAIMI_API_KEY=
KURAIMI_WEBHOOK_SECRET=

# Google OAuth 2.0 Web application
# Authorized callback: ${APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Login application
# Valid OAuth callback: ${APP_URL}/api/auth/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v21.0

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v21.0
# Optional approved authentication template. Its first body parameter receives the code.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Platform management WhatsApp number (fallback in the floating icon when no company number is set)
# Format: international number without + or spaces, e.g. 966501234567
PLATFORM_WHATSAPP_NUMBER=967774485307

# Phone verification controls
# OTP_DEMO_MODE=1 returns the verification code in the API response (development onboarding
# only — it lets anyone sign in as any phone number). Leave unset in production.
# OTP_DEMO_MODE=
OTP_TTL_SECONDS=300
OTP_RATE_LIMIT_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Public platform-support delivery (requests are always stored in the database)
PLATFORM_SUPPORT_EMAIL=support@fleetflow.app
# Optional dedicated HMAC key for pseudonymous public-form rate-limit identifiers.
# JWT_SECRET is used when this is empty.
PUBLIC_SUPPORT_HASH_SECRET=
# Optional HTTPS endpoint for forwarding a stored request to a management workflow.
PLATFORM_SUPPORT_WEBHOOK_URL=
# When set, X-FleetFlow-Signature is an HMAC-SHA256 signature of the raw JSON body.
PLATFORM_SUPPORT_WEBHOOK_SECRET=
